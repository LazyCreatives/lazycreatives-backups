{
  "name": "lazycreatives-backups",
  "productName": "LazyCreatives Backups",
  "version": "0.1.7",
  "description": "LazyCreatives Backups — verified, deduplicated backups for Ableton & FL Studio projects",
  "main": "electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env ABLEBACKUP_DEV=1 electron .",
    "start": "concurrently -k -n VITE,ELECTRON -c blue,green \"npm:dev:vite\" \"npm:dev:electron\"",
    "build": "vite build",
    "build:py": "cd ../backend && .venv/bin/pyinstaller sidecar.spec --noconfirm --distpath dist",
    "dist": "npm run build && npm run build:py && electron-builder",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.lazycreatives.backups",
    "productName": "LazyCreatives Backups",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "build/tray.png",
      "build/tray@2x.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/ablebackup-sidecar",
        "to": "sidecar"
      },
      {
        "from": "rclone",
        "to": "rclone"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "LazyCreatives Backups",
      "artifactName": "LazyCreatives-Backups-macOS-arm64.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "artifactName": "LazyCreatives-Backups-Windows-Setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio",
      "icon": "build/icon.png",
      "artifactName": "LazyCreatives-Backups-Linux-x86_64.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LazyCreatives",
        "repo": "lazycreatives-backups",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "electron-updater": "^6.8.9",
    "motion": "^12.40.0"
  }
}
